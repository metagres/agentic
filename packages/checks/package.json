{
  "name": "@agentic/checks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-contained, project-agnostic, JSON-only structural checks library with per-check parameter manifests, a dictionary-style registry, and --help support.",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts"
  },
  "bin": {
    "checks": "./src/cli.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsup"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
