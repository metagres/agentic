{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.org/schemas/planning-artifact.schema.json",
    "title": "Plan Artifact",
    "description": "Produced by task-planner. It defines the structure of the planning artifact.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "title", "status", "version",
        "tasks",
        "milestones",
        "risks"
    ],
    "properties": {
        "title": {
            "type": "string",
            "description": "The title of this document. It must encapsulate the plan being made in a short sentence"
        },
        "version": {
            "type": "string",
            "description": "Bumped on recovery (patch by default)."
        },
        "status": {
            "type": "string",
            "enum": [
                "authoring",
                "recovery",
                "rejected",
                "ready",
                "accepted"
            ],
            "description": "The status the artifact is currently in."
        },
        "tasks": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/task"
            }
        },
        "milestones": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/milestone"
            }
        },
        "risks": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/risk"
            }
        }
    },
    "$defs": {
        "file_change": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path",
                "operation"
            ],
            "properties": {
                "path": {
                    "type": "string"
                },
                "operation": {
                    "type": "string",
                    "enum": [
                        "create",
                        "modify",
                        "delete"
                    ]
                }
            }
        },
        "task": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "title",
                "description",
                "type",
                "status",
                "covers",
                "acceptance_ids"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^TASK-\\d{3,}$"
                },
                "title": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "analysis",
                        "setup",
                        "implementation",
                        "refactor",
                        "test",
                        "verification",
                        "release",
                        "documentation"
                    ]
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "pending",
                        "in_progress",
                        "done",
                        "blocked",
                        "skipped"
                    ]
                },
                "complexity": {
                    "type": "string",
                    "enum": [
                        "low",
                        "medium",
                        "high"
                    ]
                },
                "covers": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "pattern": "^(FR|NFR)-\\d{3,}$"
                    }
                },
                "acceptance_ids": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "pattern": "^AC-\\d{3,}$"
                    }
                },
                "design_refs": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^DEC-\\d{3,}$"
                    }
                },
                "depends_on": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^TASK-\\d{3,}$"
                    }
                },
                "files": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/file_change"
                    }
                },
                "implementation_note": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "started_at": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "completed_at": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "files_changed": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/file_change"
                    }
                }
            }
        },
        "milestone": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "title",
                "tasks",
                "done_when"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "tasks": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "pattern": "^TASK-\\d{3,}$"
                    }
                },
                "done_when": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "risk": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "description",
                "mitigation"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "description": {
                    "type": "string",
                    "minLength": 1
                },
                "mitigation": {
                    "type": "string",
                    "minLength": 1
                }
            }
        }
    }
}