{
  "unique-ids": {
    "params": {
      "arrays": [
        "tasks",
        "milestones",
        "risks"
      ]
    }
  },
  "ref-exists": [
    {
      "params": {
        "from": {
          "array": "milestones",
          "field": "tasks"
        },
        "to": {
          "arrays": [
            "tasks"
          ],
          "field": "id"
        }
      }
    },
    {
      "params": {
        "from": {
          "array": "tasks",
          "field": "covers"
        },
        "to": {
          "file": "requirements.yaml",
          "arrays": [
            "functional_requirements",
            "non_functional_requirements"
          ],
          "field": "id"
        }
      }
    },
    {
      "params": {
        "from": {
          "array": "tasks",
          "field": "acceptance_ids"
        },
        "to": {
          "file": "requirements.yaml",
          "arrays": [
            "functional_requirements[].acceptance_criteria",
            "non_functional_requirements[].acceptance_criteria"
          ],
          "field": "id"
        }
      }
    },
    {
      "params": {
        "from": {
          "array": "tasks",
          "field": "design_refs"
        },
        "to": {
          "file": "design.yaml",
          "arrays": [
            "decisions"
          ],
          "field": "id"
        }
      }
    }
  ],
  "dependency-acyclic": {
    "params": {
      "array": "tasks"
    }
  },
  "dependency-order": {
    "params": {
      "array": "tasks"
    }
  },
  "ref-covers": [
    {
      "params": {
        "from": {
          "array": "tasks",
          "field": "covers"
        },
        "to": {
          "file": "requirements.yaml",
          "arrays": [
            "functional_requirements",
            "non_functional_requirements"
          ],
          "field": "id"
        }
      }
    },
    {
      "params": {
        "from": {
          "array": "tasks",
          "field": "acceptance_ids"
        },
        "to": {
          "file": "requirements.yaml",
          "arrays": [
            "functional_requirements[].acceptance_criteria",
            "non_functional_requirements[].acceptance_criteria"
          ],
          "field": "id"
        }
      }
    }
  ]
}