{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.org/schemas/knowledge-extraction-artifact.schema.json",
    "title": "Docs Delta",
    "description": "Produced by knowledge-curator. It defines the structure of the knowledge-extraction artifact.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "status",
        "updated",
        "change_root",
        "deltas_applied"
    ],
    "properties": {
        "status": {
            "type": "string",
            "enum": [
                "complete"
            ],
            "description": "The status the artifact is currently in."
        },
        "updated": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "change_root": {
            "type": "string"
        },
        "deltas_applied": {
            "type": "integer",
            "minimum": 0
        }
    }
}