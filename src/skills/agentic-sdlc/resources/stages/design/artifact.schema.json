{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.org/schemas/design-artifact.schema.json",
    "title": "Design Artifact",
    "description": "Produced by systems-architect. It defines the structure of the design artifact.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "title", "status", "version",
        "context_summary",
        "components",
        "data_models",
        "apis",
        "flows",
        "decisions"
    ],
    "properties": {
        "title": {
            "type": "string",
            "description": "The title of this document. It must encapsulate the design being made in a short sentence"
        },
        "version": {
            "type": "string",
            "description": "Bumped on recovery (patch by default)."
        },
        "status": {
            "type": "string",
            "enum": [
                "authoring",
                "recovery",
                "rejected",
                "ready",
                "accepted"
            ],
            "description": "The status the artifact is currently in."
        },
        "context_summary": {
            "type": "string",
            "description": "Frames the design in one to twelve sentences — enough to orient a reviewer, without padding or a historical narrative."
        },
        "components": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/component"
            }
        },
        "data_models": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/data_model"
            }
        },
        "apis": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/api"
            }
        },
        "flows": {
            "type": "array"
        },
        "decisions": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/decision"
            }
        }
    },
    "$defs": {
        "component": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "name",
                "responsibility",
                "satisfies"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^CMP-\\d{3,}$"
                },
                "name": {
                    "type": "string"
                },
                "responsibility": {
                    "type": "string"
                },
                "satisfies": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^(FR|NFR)-\\d{3,}$"
                    }
                }
            }
        },
        "data_model": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "name"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^DM-\\d{3,}$"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "api": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "path",
                "method"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^API-\\d{3,}$"
                },
                "path": {
                    "type": "string"
                },
                "method": {
                    "type": "string"
                }
            }
        },
        "decision": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "title",
                "context",
                "decision",
                "status"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^DEC-\\d{3,}$"
                },
                "title": {
                    "type": "string"
                },
                "context": {
                    "type": "string"
                },
                "decision": {
                    "type": "string"
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "proposed",
                        "accepted",
                        "rejected",
                        "superseded"
                    ]
                }
            }
        }
    }
}