{"nodes": [{"id": "_agents_knowledge_okf_usage", "label": "OKF Usage in This Repository", "file_type": "document", "source_file": ".agents/knowledge/okf-usage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_knowledge_okf_usage_okf_bundle", "label": ".agents/knowledge as an OKF v0.2 Bundle", "file_type": "concept", "source_file": ".agents/knowledge/okf-usage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_knowledge_okf_usage_okf_spec", "label": "OKF v0.2 Specification (GoogleCloudPlatform/knowledge-catalog)", "file_type": "concept", "source_file": ".agents/knowledge/okf-usage.md", "source_location": null, "source_url": "https://github.com/GoogleCloudPlatform/knowledge-catalog/blob/main/okf/SPEC.md", "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_knowledge_okf_usage_sole_writer_rule", "label": "Curator as Sole Maintainer of the Knowledge Bundle", "file_type": "rationale", "source_file": ".agents/knowledge/okf-usage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every agent that needs durable knowledge, or produces knowledge worth keeping, delegates to the curator; a single writer keeps provenance, verification and retirements of concepts from drifting apart."}, {"id": "_agents_knowledge_okf_usage_git_history_as_change_record", "label": "Git History as the Change Record (no log.md, no generated field)", "file_type": "rationale", "source_file": ".agents/knowledge/okf-usage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OKF makes log.md optional and offers `generated` as an authorship field; git history is complete, attributed, diffable and cannot drift from the concepts it describes, whereas a per-concept author misattributes the whole text to its last editor once the body is amended."}, {"id": "_agents_knowledge_okf_usage_inlined_okf_guidance", "label": "OKF Guidance Inlined in the Curator Agent", "file_type": "rationale", "source_file": ".agents/knowledge/okf-usage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The guidance descends from the okf-knowledge-base skill but had to be adapted against this repository's conventions; inlining it in assets/agents/curator.md avoids a second, unadapted copy loaded on demand and the extra step of reintroducing it."}, {"id": "_agents_knowledge_okf_usage_okf_compatible_work_item_files", "label": "Work-item Files Are OKF-Compatible, Not Conformant", "file_type": "concept", "source_file": ".agents/knowledge/okf-usage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Work-item files take only the profitable part of OKF (type as the sole required frontmatter field, everything else opt-in), so the knowledge bundle and work-item files are kept as two deliberately separate concerns."}, {"id": "_agents_knowledge_okf_usage_single_validation_surface", "label": "sdlc validate as the Single Mechanical-Check Surface", "file_type": "rationale", "source_file": ".agents/knowledge/okf-usage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A format is not a command: document and work-item validation belongs to sdlc validate, because a command named after a format would split one job across two names and hand agents two ways to ask the same question. The stub command was removed while it still had no goal, and the parse/serialize machinery already lives in src/documents/."}, {"id": "_agents_knowledge_okf_usage_no_okf_command", "label": "No sdlc okf Command", "file_type": "concept", "source_file": ".agents/knowledge/okf-usage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_agents_knowledge_okf_usage", "target": "_agents_knowledge_index", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/knowledge/okf-usage.md", "source_location": null, "weight": 1.0}, {"source": "_agents_knowledge_okf_usage", "target": "_agents_knowledge_okf_usage_okf_bundle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/knowledge/okf-usage.md", "source_location": null, "weight": 1.0}, {"source": "_agents_knowledge_okf_usage", "target": "_agents_knowledge_okf_usage_okf_spec", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/knowledge/okf-usage.md", "source_location": null, "weight": 1.0}, {"source": "_agents_knowledge_okf_usage_okf_bundle", "target": "_agents_knowledge_okf_usage_okf_spec", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/knowledge/okf-usage.md", "source_location": null, "weight": 1.0}, {"source": "_agents_knowledge_okf_usage_sole_writer_rule", "target": "_agents_knowledge_okf_usage_okf_bundle", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/knowledge/okf-usage.md", "source_location": null, "weight": 1.0}, {"source": "_agents_knowledge_okf_usage_git_history_as_change_record", "target": "_agents_knowledge_okf_usage_okf_bundle", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/knowledge/okf-usage.md", "source_location": null, "weight": 1.0}, {"source": "_agents_knowledge_okf_usage_inlined_okf_guidance", "target": "assets_agents_curator", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/knowledge/okf-usage.md", "source_location": null, "weight": 1.0}, {"source": "_agents_knowledge_okf_usage", "ta