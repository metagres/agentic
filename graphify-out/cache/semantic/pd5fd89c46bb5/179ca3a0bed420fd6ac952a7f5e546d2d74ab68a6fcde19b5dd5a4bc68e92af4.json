{"nodes": [{"id": "_agents_knowledge_specification_overview", "label": "Agentic SDLC Toolkit \u2014 Specification Overview (Functional Core)", "file_type": "document", "source_file": ".agents/knowledge/specification/overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_knowledge_specification_overview_functional_contract", "label": "Functional Contract (what the system must do and guarantee)", "file_type": "concept", "source_file": ".agents/knowledge/specification/overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The specification is deliberately implementation-agnostic: artifact representation, authoring mechanisms, tooling and agent composition may vary as long as every requirement and invariant holds."}, {"id": "_agents_knowledge_specification_overview_gated_workflow", "label": "Gated Workflow Steps (\u00a70 Clarify, \u00a74 Plan, \u00a77 Report & commit)", "file_type": "concept", "source_file": ".agents/knowledge/specification/overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Steps marked [GATE] require explicit user approval before continuing, so approval is never an agent's to infer; the workflow is split into gated clarification, gated planning and gated commit."}, {"id": "_agents_knowledge_specification_overview_stop_and_ask", "label": "Stop and Ask Conditions", "file_type": "concept", "source_file": ".agents/knowledge/specification/overview.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_knowledge_specification_overview_investigate_preference_order", "label": "Investigate Preference Order (reuse before new code)", "file_type": "rationale", "source_file": ".agents/knowledge/specification/overview.md", "source_location": null, "source_url": null,