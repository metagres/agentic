{"nodes": [{"id": "assets_agents_curator", "label": "curator Agent (Sole Knowledge Maintainer)", "file_type": "document", "source_file": "assets/agents/curator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_agents_curator_git_history_as_change_record", "label": "Git History as the Authoritative Change Record in the Bundle", "file_type": "rationale", "source_file": "assets/agents/curator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The bundle deliberately keeps no hand-maintained log.md and forbids the `generated` field, because git history is complete, attributed and diffable while a per-concept author misattributes the whole text to whoever typed last; the commit message is therefore the change record and says what changed and why."}, {"id": "assets_agents_curator_sole_writer_trust", "label": "Sole-Writer Trust and No Invented Knowledge", "file_type": "rationale", "source_file": "assets/agents/curator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Being the only agent that may write the bundle is a trust, not a convenience: no fact, relationship, resource, source, verification or history that did not happen may be recorded, and declining to write something is a correct outcome rather than a gap."}, {"id": "assets_agents_curator_bundle_over_assumption", "label": "Bundle Is Authoritative Over an Assumption", "file_type": "rationale", "source_file": "assets/agents/curator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When the bundle contradicts what the curator was told or believes, the bundle is right and says so plainly; when it is silent or self-contradictory the curator says that instead of filling the gap, and reports disagreement with an upstream artifact rather than picking a winner."}, {"id": "assets_agents_curator_link_structure", "label": "Links as Structure (no self-restating duplicates)", "file_type": "concept", "source_file": "assets/agents/curator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A concept is the smallest useful link target, discoverable only through a link from the nearest index.md, and is never restated elsewhere to be self-contained, because a copy is a second thing to keep true."}, {"id": "assets_agents_curator_frontmatter_rules", "label": "Concept Frontmatter Rules (type required, generated forbidden)", "file_type": "concept", "source_file": "assets/agents/curator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Types are an open vocabulary (Convention, Reference, Decision, Specification, Document as a fallback never a default); version bumps its minor component per substantive amendment so a reader sees at a glance that a concept moved; verified is the human's field and may be asked for but never asserted."}, {"id": "assets_agents_curator_actor_convention", "label": "Actor Convention (human:<id>, <producer>/<version>, process:<id>)", "file_type": "concept", "source_file": "assets/agents/curator.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "assets_agents_curator", "target": "_agents_knowledge_specification_overview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "assets/agents/curator.md", "source_location": null, "weight": 1.0}, {"source": "assets_agents_curator_sole_writer_trust", "target": "assets_agents_curator", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "assets/agents/curator.md", "source_location": null, "weight": 1.0}, {"source": "assets_agents_curator_bundle_over_assumption", "target": "assets_agents_curator", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "assets/agents/curator.md", "source_location": null, "weight": 1.0}, {"source": "assets_agents_curator", "target": "_agents_knowledge_okf_usage_okf_bundle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "assets/agents/curator.md", "source_location": null, "weight": 1.0}, {"source": "assets_agents_curator", "target": "_agents_knowledge_index", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "assets/agents/curator.md", "source_location": null, "weight": 1.0}, {"source": "assets_agents_curator_git_history_as_change_record", "target": "assets_agents_curator", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "assets/agents/curator.md", "source_location": null, "weight": 1.0}, {"source": "assets_agents_curator_link_structure", "target": "assets_agents_curator", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "assets/agents/curator.md", "source_location": null, "weight": 1.0}, {"source": "assets_agents_curator_frontmatter_rules", "target": "_agents_knowledge_okf_usage_okf_bundle", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "assets/agents/curator.md", "source_location": null, "weight": 1.0}, {"source": "assets_agents_curator_actor_convention", "target": "_agents_knowledge_okf_usage_okf_bundle", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "assets/agents/curator.md", "source_location": null, "weight": 1.0}, {"source": "assets_agents_curator", "target": "_agents_knowledge_okf_usage_inlined_okf_guidance", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "assets/agents/curator.md", "source_location": null, "wei