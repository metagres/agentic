{"nodes": [{"id": "scripts_deploy_md_deploy_layer_spec", "label": "Deploy Layer Specification (scripts/DEPLOY.md)", "file_type": "document", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scripts_deploy_md_dev_time_only_scope", "label": "scripts/ Is Dev-Time Only", "file_type": "rationale", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing in scripts/ is deployed and nothing runs at toolkit runtime, so scripts/ sits outside the one-way src/ chain without altering the layering."}, {"id": "scripts_deploy_md_deploy_entrypoint", "label": "Deploy Entrypoint (node scripts/deploy.mjs)", "file_type": "concept", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scripts_deploy_md_invocation_contract", "label": "Invocation Contract (--global, --force, exclusive targets)", "file_type": "concept", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The two targets are mutually exclusive alternatives and are never merged; one invocation deploys to exactly one. Default target is resolved from import.meta.url, never the working directory."}, {"id": "scripts_deploy_md_machine_readable_output_exclusion", "label": "No Machine-Readable Output Contract (human-invoked dev-time entrypoint)", "file_type": "rationale", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A plain summary on stdout, failures on stderr, exit 0 or non-zero; the CLI's exit-code table is the CLI's own agent-facing contract and is deliberately not reused here."}, {"id": "scripts_deploy_md_file_classes", "label": "File Class Follows Ownership, Not Location", "file_type": "rationale", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A file the toolkit authors ships with the toolkit; a file an install may legitimately edit is left alone. Ownership, not path, decides redeploy behaviour."}, {"id": "scripts_deploy_md_generated_class", "label": "Generated File Class", "file_type": "concept", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scripts_deploy_md_configuration_class", "label": "Configuration File Class (skills/ only)", "file_type": "concept", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scripts_deploy_md_opencode_jsonc_never_written", "label": "opencode.jsonc Is Never Written by the Toolkit", "file_type": "rationale", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The knowledge base states opencode's own configuration is never read or written by the toolkit and it is absent from the mapping table, so an install ships without permission wiring until the operator adds it."}, {"id": "scripts_deploy_md_sdlc_mjs_bundle", "label": "Zero-Dependency Single ESM Bundle (tools/sdlc/sdlc.mjs)", "file_type": "rationale", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The one deployed build output that must need no package at all: a single ESM file that runs on a bare Node. Runtime deps cac, gray-matter, yaml, zod must be inlined and no require of an external package may survive; across the whole deployed tree @opencode/plugin is the only external package permitted, and only in tools/sdlc.ts. The rule is stated explicitly because it spans two build outputs and neither requirement section can see the other."}, {"id": "scripts_deploy_md_load_bearing_bundler_settings", "label": "Load-Bearing tsup Bundler Settings", "file_type": "rationale", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "noExternal [/.*/] because tsup externalizes dependencies by default (the bundle would be 36 KB and still import cac); banner.js providing a module-scope createRequire(import.meta.url) because gray-matter is CommonJS and its module-scope require(\"fs\") is rewritten to esbuild's __require shim, which throws - shims:true alone does not fix it; outExtension as the object form () => ({ js: \".mjs\" }) because the bare string is ignored under type:module and the wrong output name is invisible until checked; shims true. Each was found by building, and each fails silently or late without it."}, {"id": "scripts_deploy_md_import_meta_url_walkup", "label": "import.meta.url Must Survive Bundling", "file_type": "rationale", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "resolveAssetsDir() walks up from the running module for the sentinel assets/stages, so the bundle's own location must be preserved; verified by acceptance check 2."}, {"id": "scripts_deploy_md_resolve_assets_dir", "label": "resolveAssetsDir() (src/config/paths.ts)", "file_type": "concept", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scripts_deploy_md_opencode_tool_file", "label": "Opencode Tool File (tools/sdlc.ts)", "file_type": "concept", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scripts_deploy_md_tool_name_derivation", "label": "Derived Tool Names Match sdlc_* Permission Entries", "file_type": "rationale", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Export name is the command name token with - replaced by _, and opencode derives the tool name as _<exportname>, so the export name is the tool name the permission blocks in assets/agents/*.md already name. A reserved word is legal as an export but not as a binding, so it is declared under a legal binding and re-exported with the ES2022 string export name form; delete was renamed to remove rather than carried through that path."}, {"id": "scripts_deploy_md_args_derived_from_command_definitions", "label": "Tool Arguments Derived from the Command Definition", "file_type": "rationale", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Arguments are derived, never restated: positional placeholders become string arguments (required up to requiredArgs), options become strings or booleans by optionValueFlags. exactlyOneOf is not expressible because tool() takes a Zod raw shape with no refinement, so the CLI enforces mutual exclusion with exit 2 and the generated description states it. --project comes from context.directory, and --md is not exposed because markdown rendering is unimplemented."}, {"id": "scripts_deploy_md_precondition_plugin_version", "label": "Precondition: @opencode/plugin 2.0.22 in target package.json", "file_type": "rationale", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The generated file is written against that version's tool() signature, so any other version is a different contract rather than a newer patch. An install without it exposes zero sdlc_* tools and reports nothing, and a silent absence is the one failure a deploy can cheaply turn into a stated precondition. The entrypoint must not write the file nor run an install."}, {"id": "scripts_deploy_md_tool_result_exit_code_channel", "label": "Tool Result Carries CLI Exit Code and stderr Payload", "file_type": "rationale", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "tool() has no error channel, so without propagating exit code and stderr an agent cannot tell success from failure. The spawned process must have stdin closed, because a spawner leaving stdin open makes a stdin-reading invocation hang forever. Spawn runtime stays open: node:child_process with process.execPath is portable across Node and Bun, Bun.$ exists only under opencode."}, {"id": "scripts_deploy_md_agents_frontmatter_filter", "label": "Agent Frontmatter Allow-List Filtering (agents/*.md)", "file_type": "rationale", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Out-of-schema keys (such as dev) must be stripped because opencode silently routes unknown agent fields into provider model options, and every stripped key must be reported since anything other than dev is a candidate typo. Stripping rather than failing is deliberate: failing on any unknown key would break every deploy when opencode adds a field. Bodies are copied verbatim."}, {"id": "scripts_deploy_md_skills_configuration_copy", "label": "Skills Are Configuration-Class Copies", "file_type": "concept", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scripts_deploy_md_optional_source_root", "label": "Optional Source Root (missing assets/skills deploys no skills)", "file_type": "rationale", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A missing assets/skills/ deploys no skills rather than failing, so a toolkit that inlines a skill's guidance into an agent does not have to keep an empty directory alive to satisfy the mapping."}, {"id": "scripts_deploy_md_cli_assets_refresh", "label": "CLI Assets Are Generated (tools/sdlc/assets/)", "file_type": "rationale", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Everything under src/assets/ is source and source wins, so a stage, workflow or template added in source reaches every install on the next deploy and a bundle is never deployed out of step with the assets it reads."}, {"id": "scripts_deploy_md_config_yaml_policy_reset", "label": "Accepted Consequence: Deploy Resets Per-Project policy Edits", "file_type": "rationale", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "config.yaml lands in the generated set and is the only mechanism by which runtime policy is configurable per project, so a project editing policy: loses the edit on the next deploy and silently falls back to built-in defaults; work-items already created are unaffected because the policy snapshot in settings.yaml governs each for its lifetime. Per-project configuration is a post-deploy edit a deploy resets - the cost of the class rule, taken deliberately, since the alternative was an install that could not receive a toolkit asset update without also losing its own settings."}, {"id": "scripts_deploy_md_ordering_idempotence_failure", "label": "Ordering, Idempotence and Failure Semantics", "file_type": "concept", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bundling completes before any other target file is written so a bundling failure leaves the target untouched. Placement is per-file, not transactional: a partial failure leaves placed files, exits non-zero and names what it wrote. No staging-then-rename scheme would work, because a rename would clobber the configuration class it is meant to preserve. Deploying twice must be byte-identical, and deploy must not delete a target file that no longer exists in source - removal is manual."}, {"id": "scripts_deploy_md_canonical_source_changes", "label": "Canonical-Source Changes Under src/", "file_type": "concept", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scripts_deploy_md_sdlc_bin_commands_export", "label": "Export the commands Array (src/cli/bin/sdlc.ts)", "file_type": "concept", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deriving the tool file from the CLI's command definitions rather than restating it needs exactly this change; the module is already import-safe by design and importedDirectly stays false when imported, so importing it runs nothing."}, {"id": "scripts_deploy_md_shared_positional_names", "label": "Export positionalNames (src/cli/shared.ts)", "file_type": "concept", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The deploy reads placeholders from the same parser that enforces them rather than reimplementing it."}, {"id": "scripts_deploy_md_cli_errors_exit_codes", "label": "CLI Exit-Code Table (src/cli/errors.ts)", "file_type": "concept", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scripts_deploy_md_tsup", "label": "tsup (declared devDependency bundler)", "file_type": "concept", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scripts_deploy_md_opencode_plugin", "label": "@opencode/plugin (sole permitted external package)", "file_type": "concept", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scripts_deploy_md_assets_source_tree", "label": "CLI Assets Source Tree (src/assets/)", "file_type": "concept", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scripts_deploy_md_acceptance_checks", "label": "Eight Acceptance Checks Observable from the Deployed Tree", "file_type": "concept", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scripts_deploy_md_governing_document_edits", "label": "Governing-Document Edits This Decision Requires", "file_type": "concept", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Until the edits are made the specification contradicts its own governing documents, which take precedence by its first rule, leaving this one wrong."}, {"id": "scripts_deploy_md_knowledge_source_to_deployment", "label": "source-to-deployment.md (governing knowledge document)", "file_type": "document", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scripts_deploy_md_knowledge_toolkit_layout", "label": "toolkit-layout.md (governing knowledge document)", "file_type": "document", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scripts_deploy_md_knowledge_configuration_md", "label": "configuration.md section 13 (governing knowledge document)", "file_type": "document", "source_file": "scripts/DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "scripts_deploy_md_deploy_layer_spec", "target": "scripts_deploy_md_deploy_entrypoint", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "scripts/DEPLOY.md", "source_location": null, "weight": 1.0}, {"source": "scripts_deploy_md_deploy_layer_spec", "target": "scripts_deploy_md_dev_time_only_scope", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "scripts/DEPLOY.md", "source_location": null, "weight": 1.0}, {"source": "scripts_deploy_md_deploy_layer_spec", "target": "scripts_deploy_md_knowledge_source_to_deployment", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "scripts/DEPLOY.md", "source_location": null, "weight": 1.0}, {"source": "scripts_deploy_md_deploy_layer_spec", "target": "scripts_deploy_md_knowledge_toolkit_layout", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "scripts/DEPLOY.md", "source_location": null, "weight": 1.0}, {"source": "scripts_deploy_md_deploy_layer_spec", "target": "scripts_deploy_md_governing_document_edits", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "scripts/DEPLOY.md", "source_location": null, "weight": 1.0}, {"source": "scripts_deploy_md_deploy_entrypoint", "target": "scripts_deploy_md_invocation_contract", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "scripts/DEPLOY.md", "source_location": null, "weight": 1.0}, {"source": "scripts_deploy_md_deploy_layer_spec", "target": "scripts_deploy_md_machine_readable_output_exclusion", "relation": "references", "confidence": "EXTRACTED", "confidence_