agents/review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_agents_review_review_report_format", "label": "Review Report Format (verdict / findings / not checked)", "file_type": "concept", "source_file": "assets/agents/review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_agents_review_blocking_vs_advice_rule", "label": "Blocking vs Advice Rule", "file_type": "rationale", "source_file": "assets/agents/review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blocking means it violates the plan, a binding document, or correctness; everything else is advice. Reports are not padded - no findings means PASS with an empty list."}, {"id": "assets_agents_review_permission_allowlist", "label": "Frontmatter Permission Allow-List (edit/webfetch/bash denied)", "file_type": "concept", "source_file": "assets/agents/review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "edit, webfetch, skill and general bash are denied; only read-only inspection commands (git status/diff/log, ls, rg, grep) are allowed, enforcing read-onlyness structurally rather than by instruction."}], "edges": [{"source": "assets_agents_review_review_agent", "target": "assets_agents_review_read_only_review_procedure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "assets/agents/review.md", "source_location": null, "weight": 1.0}, {"source": "assets_agents_review_review_agent", "target": "assets_agents_review_permission_allowlist", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "assets/agents/review.md", "source_location": null, "weight": 1.0}, {"source": "assets_agents_review_review_agent", "target": "assets_agents_review_rev