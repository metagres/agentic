{
  "name": "agentic-sdlc-toolkit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Development repository for the agentic SDLC toolkit used by OpenCode-compatible AI coding agents.",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sdlc": "src/scripts/sdlc.ts"
  },
  "scripts": {
    "test": "node --test test/unit/*.test.ts test/e2e/*.test.ts",
    "deploy": "node bin/deploy-to-agent.ts",
    "sdlc": "node src/scripts/sdlc.ts",
    "build": "tsup",
    "validate:templates": "node bin/validate-templates.ts",
    "validate": "npm run validate:schemas && npm run validate:policies && npm run validate:templates && npm run typecheck && npm test",
    "test:unit": "node --test test/unit/*.test.ts",
    "test:e2e": "node --test test/e2e/*.test.ts",
    "validate:schemas": "node bin/validate-schemas.ts",
    "validate:policies": "node bin/validate-policies.ts",
    "check:all": "npm run test:all && npm run deploy:smoke",
    "deploy:smoke": "node bin/deploy-to-agent.ts --dest .tmp/agent --project-root .tmp/project --bundle --clean",
    "test:all": "npm run validate && npm run test:unit && npm run test:e2e",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ignore": "^7.0.6",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}